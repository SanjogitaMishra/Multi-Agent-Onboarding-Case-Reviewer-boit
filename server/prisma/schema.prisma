generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OnboardingCase {
  id            String   @id @default(cuid())
  applicantName String
  email         String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  identity      String
  address       String
  employment    String?
  documents     String?
  riskIndicators String?
  agentRuns     AgentRun[]
}

model AgentRun {
  id             String   @id @default(cuid())
  caseId         String
  onboardingCase OnboardingCase @relation(fields: [caseId], references: [id])
  mode           String
  input          String
  findings       String?
  trace          String?
  createdAt      DateTime @default(now())
  recommendations Recommendation[]
}

model Recommendation {
  id         String   @id @default(cuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id])
  result     String
  notes      String?
  createdAt  DateTime @default(now())
}
